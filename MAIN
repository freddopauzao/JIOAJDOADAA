async function addPngs(fs){snap();for(const f of fs.sort((a,b)=>a.name.localeCompare(b.name))){const d=await fileToData(f);const id=addImage(d);S().layers.push(newLayer(id,f.name.replace(/\.[^.]+$/,'')))}curL=S().layers.length-1;all();msg(fs.length+' camada(s) adicionada(s)')}
document.body.addEventListener('dragover',e=>e.preventDefault());
document.body.addEventListener('drop',async e=>{e.preventDefault();const fs=[...e.dataTransfer.files];const z=fs.find(f=>/\.(zip|json)$/i.test(f.name));const au=fs.filter(f=>f.type.startsWith('audio/')||/\.(mp3|wav|ogg|m4a|aac|flac|opus)$/i.test(f.name));if(z)await openFile(z,P.scenes.some(s=>s.layers.length));else if(au.length)await importAudio(au);else await addPngs(fs.filter(f=>f.type.startsWith('image/')))});
async function readZip(buf){const dv=new DataView(buf),u8=new Uint8Array(buf);let e=u8.length-22;while(e>=0&&dv.getUint32(e,true)!==0x06054b50)e--;if(e<0)throw new Error('ZIP inválido');const n=dv.getUint16(e+10,true);let p=dv.getUint32(e+16,true);const out={};
 for(let i=0;i<n;i++){if(dv.getUint32(p,true)!==0x02014b50)break;const meth=dv.getUint16(p+10,true),csz=dv.getUint32(p+20,true),nl=dv.getUint16(p+28,true),el=dv.getUint16(p+30,true),cl=dv.getUint16(p+32,true),lo=dv.getUint32(p+42,true);const name=new TextDecoder().decode(u8.subarray(p+46,p+46+nl));p+=46+nl+el+cl;
  const lnl=dv.getUint16(lo+26,true),lel=dv.getUint16(lo+28,true),ds=lo+30+lnl+lel;let data=u8.subarray(ds,ds+csz);
  if(meth===8){const s=new Blob([data]).stream().pipeThrough(new DecompressionStream('deflate-raw'));data=new Uint8Array(await new Response(s).arrayBuffer())}
  if(!name.endsWith('/'))out[name]=data}return out}
async function openFile(f,append){try{if(/\.json$/i.test(f.name)){const j=JSON.parse(await f.text());await loadProject(j,append)}else{const z=await readZip(await f.arrayBuffer());await loadZip(z,append)}msg('Carregado: '+f.name)}catch(err){alert('Erro ao abrir: '+err.message);console.error(err)}}
function bytesToData(u8,mime){return new Promise(r=>{const fr=new FileReader();fr.onload=()=>r(fr.result);fr.readAsDataURL(new Blob([u8],{type:mime}))})}
async function loadZip(z,append){pausePlay();const mk=Object.keys(z).find(k=>/(^|\/)manifest\.json$/.test(k));
 if(mk){const man=JSON.parse(new TextDecoder().decode(z[mk])),base=mk.replace(/manifest\.json$/,'');const scenes=[];for(const s of man.scenes){const sc=Object.assign(newScene(s.name),s,{id:uid(),layers:[]});sc.camera=Object.assign({zoom:[],x:[],y:[]},s.camera||{});sc.fx=Object.assign(newScene().fx,s.fx||{});
   for(const l of s.layers){const key=Object.keys(z).find(k=>k===l.file||k===base+l.file||k.endsWith('/'+l.file));if(!key){console.warn('arquivo ausente',l.file);continue}const id=addImage(await bytesToData(z[key],'image/png'));const nl=Object.assign(newLayer(id,l.name),l,{id:uid(),imgId:id});delete nl.file;nl.keys=Object.assign({x:[],y:[],scale:[],rot:[],opacity:[]},l.keys||{});nl.breath=Object.assign({amp:0,freq:.3},l.breath||{});nl.sway=Object.assign({x:0,y:0,freq:.2},l.sway||{});nl.pivot=Object.assign({x:.5,y:.5},l.pivot||{});sc.layers.push(nl)}scenes.push(sc)}
  const has=P.scenes.some(s=>s.layers.length);if(!append||!has){P.scenes=[]}snap();const at=P.scenes.length;P.scenes.push(...scenes);cur=at}
 else{const pngs=Object.keys(z).filter(k=>/\.(png|webp|jpe?g)$/i.test(k)).sort();if(!pngs.length)throw new Error('ZIP sem imagens');if(!append)P.scenes=[];const sc=newScene();for(const k of pngs){const ext=k.split('.').pop().toLowerCase();const id=addImage(await bytesToData(z[k],'image/'+(ext==='jpg'?'jpeg':ext)));sc.layers.push(newLayer(id,k.split('/').pop().replace(/\.[^.]+$/,'')))}P.scenes.push(sc);cur=P.scenes.length-1}
 curL=S().layers.length-1;setG(sceneStart(cur));selKey=null;fixTrack();all()}
async function loadProject(j,append){pausePlay();const imgs=j.images||{},map={};for(const id in imgs){map[id]=addImage(imgs[id])}const amap={};for(const id in (j.audios||{})){const d=j.audios[id];const ab=await (await fetch(d)).arrayBuffer();amap[id]=await addAudioAsset((j.audioNames||{})[id]||'áudio',ab,d)}
 const sc=(j.scenes||[]).map(s=>{s.layers.forEach(l=>{l.imgId=map[l.imgId]||l.imgId;l.pivot=l.pivot||{x:.5,y:.5}});return s});
 if(!append){P={title:j.title||'Projeto',fps:60,scenes:[],tracks:(j.tracks&&j.tracks.length?j.tracks:[newTrack('Narração'),newTrack('Efeitos'),newTrack('Trilha')]),clips:[]}}
 const off=append?totalDur():0;(j.clips||[]).forEach(c=>{if(amap[c.aud])P.clips.push({...c,aud:amap[c.aud],start:c.start+off})});
 if(append&&j.tracks)j.tracks.forEach(t=>{if(!P.tracks.find(x=>x.id===t.id))P.tracks.push(t)});
 const at=P.scenes.length;P.scenes.push(...sc);cur=append?at:0;curL=S()&&S().layers.length-1;G=sceneStart(cur);undo=[];all()}
