  tg.fillStyle='#15171a';tg.fillRect(sx,RULER,LBL,Hh);tr.forEach((r,i)=>{const y=RULER+i*RH,on=selTrack&&r.kind===selTrack.kind&&r.prop===selTrack.prop&&(r.kind==='cam'||r.li===selTrack.li);tg.fillStyle=on?'#2a1d1a':(i%2?'#181a1d':'#1b1d21');tg.fillRect(sx,y,LBL,RH);tg.fillStyle=on?'#e9a23b':'#a9b0b7';tg.fillText(r.label,sx+8,y+RH/2)});
