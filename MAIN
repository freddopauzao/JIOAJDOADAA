 else if(tab==='audio'){const c=clipObj(),tk=P.tracks[curTrk];
  if(tk)el.append(txt('Trilha',()=>tk.name,v=>tk.name=v),num('Volume trilha',()=>tk.vol,v=>tk.vol=clamp(v,0,2),.05));
