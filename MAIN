/* ============ ÁUDIO ============ */
function getAC(){if(!ac){ac=new (window.AudioContext||window.webkitAudioContext)({latencyHint:'interactive'})}if(ac.state==='suspended')ac.resume();return ac}
async function decodeData(buf){const oc=new (window.OfflineAudioContext||window.webkitOfflineAudioContext)(2,48000,48000);return await oc.decodeAudioData(buf)}
function mkPeaks(ab){const ch=ab.getChannelData(0),ch2=ab.numberOfChannels>1?ab.getChannelData(1):null,N=Math.ceil(ab.length/512),pk=new Float32Array(N);for(let i=0;i<N;i++){let m=0;const e=Math.min(ab.length,(i+1)*512);for(let j=i*512;j<e;j+=2){const v=Math.max(Math.abs(ch[j]),ch2?Math.abs(ch2[j]):0);if(v>m)m=v}pk[i]=m}return{peaks:pk,pps:ab.sampleRate/512}}
async function addAudioAsset(name,arrayBuf,dataUrl){const copy=arrayBuf.slice(0);const buf=await decodeData(copy);const id=uid();const pk=mkPeaks(buf);AUD[id]={name,data:dataUrl,buf,peaks:pk.peaks,pps:pk.pps};return id}
function fileToData(f){return new Promise(r=>{const fr=new FileReader();fr.onload=()=>r(fr.result);fr.readAsDataURL(f)})}
async function importAudio(files){snap();for(const f of files){try{const ab=await f.arrayBuffer();const data=await fileToData(f);const id=await addAudioAsset(f.name,ab,data);const tk=P.tracks[clamp(curTrk,0,P.tracks.length-1)];P.clips.push({id:uid(),aud:id,track:tk.id,start:Math.round(G*100)/100,off:0,dur:AUD[id].buf.duration,vol:1,fi:0,fo:0,name:f.name.replace(/\.[^.]+$/,'')});selClip=P.clips[P.clips.length-1].id}catch(err){alert('Não consegui decodificar '+f.name+': '+err.message)}}setMode('proj');tab='audio';$$('.tabs button').forEach(b=>b.classList.toggle('on',b.dataset.t==='audio'));all();msg(files.length+' áudio(s) adicionado(s)')}
$('#aAdd').onclick=()=>$('#fAud').click();$('#fAud').onchange=async e=>{const fs=[...e.target.files];e.target.value='';await importAudio(fs)};
$('#aTrk').onclick=()=>{snap();P.tracks.push(newTrack());curTrk=P.tracks.length-1;all()};
