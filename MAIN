   num('Respiração %',()=>(l.breath.amp||0)*100,v=>l.breath.amp=v/100,.1),num('Resp. Hz',()=>l.breath.freq,v=>l.breath.freq=v,.05),
   num('Deriva X px',()=>l.sway.x,v=>l.sway.x=v,1),num('Deriva Y px',()=>l.sway.y,v=>l.sway.y=v,1),num('Deriva Hz',()=>l.sway.freq,v=>l.sway.freq=v,.05),num('Vibração px',()=>l.jitter||0,v=>l.jitter=v,.1))}
