const nextTask=()=>new Promise(r=>{const c=new MessageChannel();c.port1.onmessage=()=>r();c.port2.postMessage(0)});
function setProg(f,t){$('#prog i').style.width=(f*100)+'%';if(t)$('#xInfo').textContent=t}
async function pickVideo(w,h,fps,mbps){const lv=Math.max(w,h)>=1900?['avc1.64002A','avc1.640032','avc1.4D002A','avc1.42002A']:['avc1.640028','avc1.64002A','avc1.4D0028','avc1.420028'];const vp=['vp09.00.41.08','vp09.00.40.08','vp09.00.31.08'];
 const mk=c=>({codec:c,width:w,height:h,framerate:fps,bitrate:Math.round(mbps*1e6),latencyMode:'quality',...(c.startsWith('avc1')?{avc:{format:'avc'}}:{})});
 for(const c of lv){try{const s=await VideoEncoder.isConfigSupported(mk(c));if(s.supported)return{cfg:mk(c),kind:'avc1'}}catch(e){}}
 for(const c of vp){try{const s=await VideoEncoder.isConfigSupported(mk(c));if(s.supported)return{cfg:mk(c),kind:'vp09'}}catch(e){}}return null}
async function pickAudio(){for(const c of['mp4a.40.2','opus']){try{const cfg={codec:c,sampleRate:48000,numberOfChannels:2,bitrate:192000};const s=await AudioEncoder.isConfigSupported(cfg);if(s.supported)return{cfg,kind:c==='opus'?'Opus':'mp4a'}}catch(e){}}return null}
async function renderMix(g0,g1){const sr=48000,len=Math.ceil((g1-g0)*sr);const oc=new OfflineAudioContext(2,len,sr);scheduleClips(oc,oc.destination,g0,0,g1);return await oc.startRendering()}
async function exportMP4(o){const{w,h,fps,g0,g1,mbps}=o,N=Math.max(1,Math.round((g1-g0)*fps));const vp=await pickVideo(w,h,fps,mbps);if(!vp)throw new Error('Este navegador não tem codificador de vídeo (WebCodecs).');
 const hasAudio=P.clips.some(c=>clipGainBase(c)>0);let ap=null,mix=null;if(hasAudio){ap=await pickAudio();setProg(0,'Mixando áudio…');mix=await renderMix(g0,g1)}
 const mux=new Mp4Muxer(w,h,fps);mux.vcodec=vp.kind;mux.vcodecStr=vp.cfg.codec;let err=null;
 const venc=new VideoEncoder({output:(ch,meta)=>{if(meta&&meta.decoderConfig&&meta.decoderConfig.description)mux.vcfg=new Uint8Array(meta.decoderConfig.description);const d=new Uint8Array(ch.byteLength);ch.copyTo(d);mux.addV(d,ch.timestamp,ch.duration||1e6/fps,ch.type==='key')},error:e=>{err=e}});
 venc.configure(vp.cfg);
 const c=document.createElement('canvas');c.width=w;c.height=h;const ex=c.getContext('2d',{alpha:false});const k=w/CW;
 const t0=performance.now();
 for(let n=0;n<N;n++){if(cancelExp){venc.close();throw new Error('cancelado')}if(err)throw err;const g=g0+n/fps,l=locate(g);render(ex,P.scenes[l.i],clamp(g-sceneStart(l.i),0,P.scenes[l.i].duration),k);
  const fr=new VideoFrame(c,{timestamp:Math.round(n*1e6/fps),duration:Math.round(1e6/fps)});venc.encode(fr,{keyFrame:n%(fps*2)===0});fr.close();
  while(venc.encodeQueueSize>6)await nextTask();if(n%6===0){const el=(performance.now()-t0)/1000;setProg(n/N*(hasAudio?.9:.97),'Vídeo '+(n+1)+'/'+N+' quadros · '+(n/Math.max(.1,el)).toFixed(0)+' quadros/s');await nextTask()}}
 await venc.flush();venc.close();
 if(mix&&ap){setProg(.92,'Codificando áudio ('+(ap.kind==='mp4a'?'AAC':'Opus')+')…');mux.acodec=ap.kind;const aenc=new AudioEncoder({output:(ch,meta)=>{if(meta&&meta.decoderConfig&&meta.decoderConfig.description)mux.acfg=new Uint8Array(meta.decoderConfig.description);const d=new Uint8Array(ch.byteLength);ch.copyTo(d);mux.addA(d,ch.timestamp,ch.duration||(ap.kind==='mp4a'?1024/48000*1e6:20000))},error:e=>{err=e}});aenc.configure(ap.cfg);
  const L=mix.getChannelData(0),R=mix.numberOfChannels>1?mix.getChannelData(1):L,BL=4800;for(let p=0;p<mix.length;p+=BL){const n=Math.min(BL,mix.length-p),buf=new Float32Array(n*2);buf.set(L.subarray(p,p+n),0);buf.set(R.subarray(p,p+n),n);const ad=new AudioData({format:'f32-planar',sampleRate:48000,numberOfFrames:n,numberOfChannels:2,timestamp:Math.round(p/48000*1e6),data:buf});aenc.encode(ad);ad.close();while(aenc.encodeQueueSize>20)await nextTask()}
  await aenc.flush();aenc.close();if(mux.acodec==='mp4a'&&!mux.acfg)mux.acfg=new Uint8Array([0x11,0x90])}
 if(err)throw err;if(mux.vcodec==='avc1'&&!mux.vcfg)throw new Error('O codificador não devolveu a configuração H.264.');
 setProg(.98,'Gravando arquivo…');const blob=mux.build();return{blob,info:(vp.kind==='avc1'?'H.264':'VP9')+(mix&&ap?' + '+(ap.kind==='mp4a'?'AAC':'Opus'):' (sem áudio)')}}
async function exportRealtime(o){const{w,h,fps,g0,g1,mbps}=o,dur=g1-g0;const c=document.createElement('canvas');c.width=w;c.height=h;const ex=c.getContext('2d',{alpha:false}),stream=c.captureStream(fps);let a=null;
 if(P.clips.length){a=getAC();const dst=a.createMediaStreamDestination();srcs=scheduleClips(a,dst,g0,a.currentTime+.15,g1);dst.stream.getAudioTracks().forEach(t=>stream.addTrack(t))}
 const mime=['video/webm;codecs=vp9,opus','video/webm;codecs=vp8,opus','video/webm'].find(m=>MediaRecorder.isTypeSupported(m))||'';const rec=new MediaRecorder(stream,{mimeType:mime,videoBitsPerSecond:mbps*1e6}),ch=[];rec.ondataavailable=e=>e.data.size&&ch.push(e.data);const done=new Promise(r=>rec.onstop=r);
 await new Promise(r=>setTimeout(r,160));rec.start(500);const t0=performance.now();
 await new Promise(res=>{const step=()=>{if(cancelExp){res();return}const t=(performance.now()-t0)/1000;if(t>=dur){res();return}const g=g0+t,l=locate(g);render(ex,P.scenes[l.i],clamp(g-sceneStart(l.i),0,P.scenes[l.i].duration),w/CW);setProg(t/dur,'Gravando em tempo real '+t.toFixed(1)+' / '+dur.toFixed(1)+'s');requestAnimationFrame(step)};step()});
 rec.stop();stopAudio();await done;return{blob:new Blob(ch,{type:'video/webm'}),info:'WebM em tempo real'}}
function downloadBlob(blob,name){const a=document.createElement('a');a.href=URL.createObjectURL(blob);a.download=name;a.click()}
$('#bExport').onclick=async()=>{pausePlay();$('#modal').style.display='flex';setProg(0,'');$('#xGo').disabled=false;const sup=[];try{if(typeof VideoEncoder==='undefined')sup.push('WebCodecs indisponível → será usado o modo em tempo real (WebM).');else{const h264=await VideoEncoder.isConfigSupported({codec:'avc1.64002A',width:1080,height:1920,framerate:60,bitrate:1e7,avc:{format:'avc'}}).then(r=>r.supported).catch(()=>false);const aac=await AudioEncoder.isConfigSupported({codec:'mp4a.40.2',sampleRate:48000,numberOfChannels:2,bitrate:192000}).then(r=>r.supported).catch(()=>false);sup.push('Neste navegador: H.264 '+(h264?'✓':'✗ (usará VP9 dentro do MP4)')+' · AAC '+(aac?'✓':'✗ (usará Opus)'))}}catch(e){}
