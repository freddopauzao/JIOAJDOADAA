   tg.fillStyle=tk.mute?'#c9482f':'#2c2f36';tg.fillRect(sx+8,y+24,22,16);tg.fillStyle='#fff';tg.fillText('M',sx+15,y+32);tg.fillStyle=tk.solo?'#e9a23b':'#2c2f36';tg.fillRect(sx+34,y+24,22,16);tg.fillStyle=tk.solo?'#000':'#fff';tg.fillText('S',sx+42,y+32);tg.fillStyle='#8a9199';tg.fillText('vol '+Math.round(tk.vol*100)+'%',sx+62,y+32)});
  const ph=t2x(G);tg.fillStyle='#e9a23b';tg.fillRect(ph-.5,0,1.5,Hh);tg.beginPath();tg.moveTo(ph-6,0);tg.lineTo(ph+6,0);tg.lineTo(ph,9);tg.fill()
 }else{
