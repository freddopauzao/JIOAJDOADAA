function splitClip(){const c=clipObj();if(!c||G<=c.start+.05||G>=c.start+c.dur-.05)return;snap();const d=G-c.start,n={...c,id:uid(),start:G,off:c.off+d,dur:c.dur-d,fi:0};c.dur=d;c.fo=0;P.clips.push(n);selClip=n.id;all()}
function delClip(){if(!selClip)return;snap();P.clips=P.clips.filter(c=>c.id!==selClip);selClip=null;all()}
$('#aSplit').onclick=splitClip;$('#aDel').onclick=delClip;$('#aDup').onclick=()=>{const c=clipObj();if(!c)return;snap();const n={...c,id:uid(),start:c.start+c.dur};P.clips.push(n);selClip=n.id;all()};
const anySolo=()=>P.tracks.some(t=>t.solo);
function clipGainBase(c){const tk=P.tracks.find(t=>t.id===c.track);if(!tk)return 0;if(anySolo()?!tk.solo:tk.mute)return 0;return c.vol*tk.vol}
/* agenda clipes em qualquer contexto (ao vivo ou offline): fromG = tempo global onde começa, at = tempo do contexto correspondente */
function scheduleClips(ctx,dest,fromG,at,toG){const out=[];P.clips.forEach(c=>{const a=AUD[c.aud];if(!a)return;const gb=clipGainBase(c);if(gb<=0)return;const ce=c.start+c.dur;if(ce<=fromG||(toG!==undefined&&c.start>=toG))return;
 const s0=Math.max(c.start,fromG),skip=s0-c.start,when=at+(s0-fromG),endT=toG!==undefined?Math.min(ce,toG):ce,dur=endT-s0;if(dur<=0)return;
 const src=ctx.createBufferSource();src.buffer=a.buf;const g=ctx.createGain();src.connect(g);g.connect(dest);
 const env=t=>{let v=1;if(c.fi>0&&t<c.start+c.fi)v=Math.min(v,(t-c.start)/c.fi);if(c.fo>0&&t>ce-c.fo)v=Math.min(v,(ce-t)/c.fo);return clamp(v,0,1)*gb};
 g.gain.setValueAtTime(env(s0),when);
 if(c.fi>0&&s0<c.start+c.fi){g.gain.linearRampToValueAtTime(gb,when+(c.start+c.fi-s0))}
 if(c.fo>0&&endT>ce-c.fo){const tf=Math.max(s0,ce-c.fo);g.gain.setValueAtTime(env(tf),when+(tf-s0));g.gain.linearRampToValueAtTime(0,when+(ce-s0))}
 src.start(when,c.off+skip,dur);out.push(src)});return out}
function playAudio(){stopAudio();const a=getAC();srcs=scheduleClips(a,a.destination,G,a.currentTime+.05)}
function stopAudio(){srcs.forEach(s=>{try{s.stop()}catch(e){}});srcs=[]}
