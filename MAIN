function ktracks(){const sc=S(),r=[{kind:'cam',prop:'zoom',label:'Câmera · zoom'},{kind:'cam',prop:'x',label:'Câmera · pan X'},{kind:'cam',prop:'y',label:'Câmera · pan Y'}];if(sc&&curL>=0&&sc.layers[curL]){const n=sc.layers[curL].name;[['x','X'],['y','Y'],['scale','escala'],['rot','rotação'],['opacity','opacidade']].forEach(([p,l])=>r.push({kind:'layer',li:curL,prop:p,label:n.slice(0,14)+' · '+l}))}return r}
function pps(){const avail=wrap.clientWidth-LBL-24;if(tlMode==='proj')return Math.max(4,avail/Math.max(totalDur(),10)*tlZoom);const sc=S();return Math.max(20,avail/(sc?sc.duration:8)*tlZoom)}
