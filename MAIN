function evPos(e){const r=tlc.getBoundingClientRect();return{x:e.clientX-r.left,y:e.clientY-r.top}}
let drag=null;
function snapT(t,self){let best=t,bd=8/pps();const cands=[0,G];let a=0;P.scenes.forEach(s=>{cands.push(a);a+=s.duration;cands.push(a)});P.clips.forEach(c=>{if(c.id!==self){cands.push(c.start);cands.push(c.start+c.dur)}});cands.forEach(c=>{if(Math.abs(c-t)<bd){bd=Math.abs(c-t);best=c}});return best}
tlc.onmousedown=e=>{if(!P.scenes.length)return;const{x,y}=evPos(e),sx=wrap.scrollLeft;
 if(tlMode==='proj'){
  if(y<RULER){setG(clamp(x2t(x),0,totalDur()));drag={seek:true};all(true);return}
  if(y<RULER+SCH){ // cenas
   let acc=0;for(let i=0;i<P.scenes.length;i++){const d=P.scenes[i].duration,xe=t2x(acc+d);if(Math.abs(x-xe)<6&&x>LBL){snap();drag={resize:i,x0:x,d0:d};return}if(x>t2x(acc)&&x<xe&&x>sx+LBL){drag={sceneMove:i,x0:x,moved:false};cur=i;setG(clamp(x2t(x),acc,acc+d-.001),true);curL=Math.min(curL,P.scenes[i].layers.length-1);all();return}acc+=d}return}
  const ti=Math.floor((y-RULER-SCH)/TRH);if(ti<0||ti>=P.tracks.length)return;const tk=P.tracks[ti];
  if(x<sx+LBL){curTrk=ti;const yy=y-(RULER+SCH+ti*TRH);if(yy>24&&yy<40){if(x-sx>=8&&x-sx<30){snap();tk.mute=!tk.mute}else if(x-sx>=34&&x-sx<56){snap();tk.solo=!tk.solo}}inspector();draw();return}
  const t=x2t(x);let hitc=null;for(let k=P.clips.length-1;k>=0;k--){const c=P.clips[k];if(c.track===tk.id&&t>=c.start&&t<=c.start+c.dur){hitc=c;break}}
  curTrk=ti;if(hitc){selClip=hitc.id;const ex=6/pps();snap();if(t-hitc.start<ex)drag={trimL:hitc,x0:x,s0:hitc.start,o0:hitc.off,d0:hitc.dur};else if(hitc.start+hitc.dur-t<ex)drag={trimR:hitc,x0:x,d0:hitc.dur};else drag={move:hitc,x0:x,s0:hitc.start,t0:hitc.track};tab='audio';$$('.tabs button').forEach(b=>b.classList.toggle('on',b.dataset.t==='audio'));inspector();draw();return}
  selClip=null;setG(clamp(t,0,totalDur()));drag={seek:true};all(true);return}
 // modo keyframes
 const tr=ktracks();if(y<RULER){setG(sceneStart(cur)+clamp(x2t(x),0,S().duration),true);drag={kseek:true};draw();return}
 const i=Math.floor((y-RULER)/RH);if(i<0||i>=tr.length)return;const t=tr[i],o=trackObj(t);selTrack={kind:t.kind,prop:t.prop,li:t.li};let ki=-1;if(o&&x>sx+LBL){let best=8;o.keys.forEach((k,j)=>{const dd=Math.abs(t2x(k.t)-x);if(dd<best){best=dd;ki=j}})}
 if(ki>=0){snap();selKey={tr:{...selTrack},i:ki};drag={key:true};tab='key';$$('.tabs button').forEach(b=>b.classList.toggle('on',b.dataset.t==='key'))}else{selKey=null;if(x>sx+LBL){setG(sceneStart(cur)+clamp(x2t(x),0,S().duration),true)}}inspector();draw()};
window.addEventListener('mousemove',e=>{if(!drag)return;const{x}=evPos(e);
 if(drag.seek){setG(clamp(x2t(x),0,totalDur()));all(true)}
 else if(drag.kseek){setG(sceneStart(cur)+clamp(x2t(x),0,S().duration),true);draw()}
 else if(drag.resize!==undefined){const sc=P.scenes[drag.resize];sc.duration=Math.max(.5,Math.round((drag.d0+(x-drag.x0)/pps())*20)/20);draw()}
 else if(drag.sceneMove!==undefined){if(Math.abs(x-drag.x0)>8)drag.moved=true;drag.mx=x}
 else if(drag.move){const c=drag.move;let ns=Math.max(0,snapT(drag.s0+(x-drag.x0)/pps(),c.id));c.start=ns;const{y}=evPos(e);const ti=Math.floor((y-RULER-SCH)/TRH);if(ti>=0&&ti<P.tracks.length)c.track=P.tracks[ti].id;draw()}
 else if(drag.trimL){const c=drag.trimL;let d=(x-drag.x0)/pps();d=clamp(d,-drag.o0,drag.d0-.05);c.start=Math.max(0,drag.s0+d);c.off=drag.o0+d;c.dur=drag.d0-d;draw()}
 else if(drag.trimR){const c=drag.trimR;c.dur=clamp(drag.d0+(x-drag.x0)/pps(),.05,AUD[c.aud].buf.duration-c.off);draw()}
 else if(drag.key&&selKey){const o=trackObj(selKey.tr),k=o.keys[selKey.i];if(!k)return;k.t=clamp(Math.round(x2t(x)*100)/100,0,S().duration);o.keys.sort((a,b)=>a.t-b.t);selKey.i=o.keys.indexOf(k);setG(sceneStart(cur)+k.t,true);draw()}});
window.addEventListener('mouseup',e=>{if(!drag)return;if(drag.sceneMove!==undefined&&drag.moved){const{x}=evPos(e);let acc=0,to=0;P.scenes.forEach((s,i)=>{if(x>t2x(acc+s.duration/2))to=i+1;acc+=s.duration});const from=drag.sceneMove;if(to>from)to--;if(to!==from){const[s]=P.scenes.splice(from,1);P.scenes.splice(to,0,s);cur=to;setG(sceneStart(to))}all()}else if(drag.key||drag.move||drag.trimL||drag.trimR||drag.resize!==undefined)all();drag=null});
tlc.ondblclick=e=>{if(tlMode!=='key')return;const{x,y}=evPos(e),tr=ktracks(),i=Math.floor((y-RULER)/RH);if(i<0||i>=tr.length||x<LBL)return;const t=tr[i];snap();selTrack={kind:t.kind,prop:t.prop,li:t.li};const o=trackObj(selTrack),tt=clamp(x2t(x),0,S().duration);const k=setKey(o.keys,tt,evalKeys(o.keys,tt,o.base));selKey={tr:{...selTrack},i:o.keys.indexOf(k)};setG(sceneStart(cur)+tt,true);all(true)};
function addKeyHere(){if(tlMode!=='key')return;snap();const o=trackObj(selTrack);if(!o)return;const k=setKey(o.keys,LT(),evalKeys(o.keys,LT(),o.base));selKey={tr:{...selTrack},i:o.keys.indexOf(k)};all(true)}
