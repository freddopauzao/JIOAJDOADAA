 exporting=true;cancelExp=false;$('#xGo').disabled=true;const o={w,h,fps,g0,g1,mbps};try{let r;const useMp4=$('#xFmt').value==='mp4'&&typeof VideoEncoder!=='undefined';r=useMp4?await exportMP4(o):await exportRealtime(o);if(cancelExp)throw new Error('cancelado');const ext=r.blob.type==='video/mp4'?'mp4':'webm';downloadBlob(r.blob,'teatro-sombrio-'+h+'p'+fps+'.'+ext);setProg(1,'Pronto: '+r.info+' · '+(r.blob.size/1048576).toFixed(1)+' MB · '+w+'×'+h+' @ '+fps+' fps');msg('Exportado ('+ext+')')}catch(err){setProg(0,'Erro: '+err.message);console.error(err)}exporting=false;$('#xGo').disabled=false};
