  else el.append(txt('Clipe',()=>c.name,v=>c.name=v),num('Início (s)',()=>c.start,v=>c.start=Math.max(0,v),.05),num('Corte início (s)',()=>c.off,v=>c.off=clamp(v,0,AUD[c.aud].buf.duration-.05),.05),num('Duração (s)',()=>c.dur,v=>c.dur=clamp(v,.05,AUD[c.aud].buf.duration-c.off),.05),num('Volume',()=>c.vol,v=>c.vol=clamp(v,0,3),.05),num('Fade in (s)',()=>c.fi,v=>c.fi=Math.max(0,v),.05),num('Fade out (s)',()=>c.fo,v=>c.fo=Math.max(0,v),.05),sel('Trilha',P.tracks.map((t,i)=>[String(i),t.name]),()=>String(P.tracks.findIndex(t=>t.id===c.track)),v=>c.track=P.tracks[+v].id))}
 else{const o=selKey&&trackObj(selKey.tr);const k=o&&o.keys[selKey.i];if(!k){el.innerHTML='<div class="hint">Na aba "Keyframes da cena", clique num losango para editá-lo.</div>';return}
