 tg.fillStyle='#15171a';tg.fillRect(sx,0,LBL,RULER);tg.fillStyle='#8a9199';tg.fillText(tlMode==='proj'?'PROJETO':'CENA '+(cur+1),sx+8,RULER/2)}
