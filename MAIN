<script>
'use strict';
const $=s=>document.querySelector(s),$$=s=>[...document.querySelectorAll(s)];
const CW=540,CH=960,FPS=60;
let P,IMG={},AUD={},cur=0,curL=-1,G=0,playing=false,selTrack={kind:'cam',prop:'zoom'},selKey=null,selClip=null,curTrk=0,tab='scene',tlMode='proj',tlZoom=1,undo=[],redo=[],ac=null,play0={g:0,t:0},srcs=[],exporting=false,cancelExp=false;
const uid=()=>Math.random().toString(36).slice(2,9);
const hash=n=>{const s=Math.sin(n*127.1+311.7)*43758.5453;return (s-Math.floor(s))*2-1};
const vn=(x,sd=0)=>{const i=Math.floor(x),f=x-i,u=f*f*(3-2*f);return hash(i+sd*17.3)*(1-u)+hash(i+1+sd*17.3)*u};
const clamp=(v,a,b)=>Math.max(a,Math.min(b,v));
const msg=t=>{$('#msg').textContent=t;clearTimeout(msg.t);msg.t=setTimeout(()=>$('#msg').textContent='',5000)};
const esc=s=>String(s).replace(/[&<>"]/g,c=>({'&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;'}[c]));
function newTrack(name){return{id:uid(),name:name||('Áudio '+(((P&&P.tracks)||[]).length+1)),vol:1,mute:false,solo:false}}
function newScene(name){return{id:uid(),name:name||('CENA '+String(P.scenes.length+1).padStart(2,'0')),duration:8,narration:'',sound:'',notes:'',shake:0,camera:{zoom:[],x:[],y:[]},fx:{grain:.35,vignette:.6,flicker:.08,tint:'#0a1a22',tintOp:0,fadeIn:0,fadeOut:0,subtitles:true},layers:[]}}
function newLayer(imgId,name){return{id:uid(),name:name||'camada',imgId,visible:true,parallax:1,blend:'source-over',x:0,y:0,scale:1,rot:0,opacity:1,pivot:{x:.5,y:.5},breath:{amp:0,freq:.3},sway:{x:0,y:0,freq:.2},jitter:0,keys:{x:[],y:[],scale:[],rot:[],opacity:[]}}}
P={title:'Projeto',fps:60,scenes:[],tracks:[],clips:[]};P.tracks=[newTrack('Narração'),newTrack('Efeitos'),newTrack('Trilha')];
const S=()=>P.scenes[cur];
const sceneStart=i=>{let s=0;for(let k=0;k<i;k++)s+=P.scenes[k].duration;return s};
const totalDur=()=>P.scenes.reduce((a,s)=>a+s.duration,0);
function locate(g){let s=0;for(let i=0;i<P.scenes.length;i++){const d=P.scenes[i].duration;if(g<s+d||i===P.scenes.length-1)return{i,t:clamp(g-s,0,d)};s+=d}return{i:0,t:0}}
const LT=()=>S()?clamp(G-sceneStart(cur),0,S().duration):0;
function snap(){undo.push(JSON.stringify(P));if(undo.length>60)undo.shift();redo=[]}
function doUndo(){if(!undo.length)return;redo.push(JSON.stringify(P));P=JSON.parse(undo.pop());cur=clamp(cur,0,P.scenes.length-1);curL=clamp(curL,-1,(S()?S().layers.length:0)-1);all()}
function doRedo(){if(!redo.length)return;undo.push(JSON.stringify(P));P=JSON.parse(redo.pop());cur=clamp(cur,0,P.scenes.length-1);all()}
function setG(g,keepScene){G=clamp(g,0,Math.max(0,totalDur()));const l=locate(G);if(l.i!==cur&&!keepScene){cur=l.i;curL=Math.min(curL<0?S().layers.length-1:curL,S().layers.length-1);listScenes();listLayers();inspector()}}
function loadImg(id){const o=IMG[id];if(!o||o.im)return;o.im=new Image();o.im.onload=()=>{draw();thumbs()};o.im.src=o.data}
function addImage(data){const id=uid();IMG[id]={data,im:null};loadImg(id);return id}
function ease(e,u){return e==='linear'?u:u*u*(3-2*u)}
function evalKeys(keys,t,base){if(!keys||!keys.length)return base;if(t<=keys[0].t)return keys[0].v;for(let i=1;i<keys.length;i++){if(t<=keys[i].t){const a=keys[i-1],b=keys[i];const u=(t-a.t)/((b.t-a.t)||1);return a.v+(b.v-a.v)*ease(a.e||'ease',u)}}return keys[keys.length-1].v}
function trackObj(tr,sc=S()){if(!sc)return null;if(tr.kind==='cam')return{keys:sc.camera[tr.prop],base:tr.prop==='zoom'?1:0};const l=sc.layers[tr.li];if(!l)return null;return{keys:l.keys[tr.prop],base:l[tr.prop]}}
function setKey(keys,t,v,e){t=Math.round(t*100)/100;let k=keys.find(k=>Math.abs(k.t-t)<.011);if(k){k.v=v;if(e)k.e=e}else{k={t,v,e:e||'ease'};keys.push(k);keys.sort((a,b)=>a.t-b.t)}return k}
/* ============ RENDER (taxa-independente: tudo é função contínua do tempo) ============ */
const cv=$('#cv'),cx=cv.getContext('2d');
const GRAIN_HZ=24,grain=[];(function(){for(let f=0;f<6;f++){const c=document.createElement('canvas');c.width=270;c.height=480;const g=c.getContext('2d'),d=g.createImageData(270,480);for(let i=0;i<d.data.length;i+=4){const v=Math.random()<.5?0:255;d.data[i]=d.data[i+1]=d.data[i+2]=v;d.data[i+3]=Math.random()*70|0}g.putImageData(d,0,0);grain.push(c)}})();
function layerState(l,t){return{x:evalKeys(l.keys.x,t,l.x),y:evalKeys(l.keys.y,t,l.y),scale:evalKeys(l.keys.scale,t,l.scale),rot:evalKeys(l.keys.rot,t,l.rot),opacity:evalKeys(l.keys.opacity,t,l.opacity)}}
function render(ctx,sc,t,k,opt={}){
 ctx.save();ctx.setTransform(k,0,0,k,0,0);ctx.globalAlpha=1;ctx.globalCompositeOperation='source-over';ctx.fillStyle='#000';ctx.fillRect(0,0,CW,CH);
 const cz=evalKeys(sc.camera.zoom,t,1),ccx=evalKeys(sc.camera.x,t,0),ccy=evalKeys(sc.camera.y,t,0);
 const sh=sc.shake||0,shx=vn(t*26,1)*sh*7,shy=vn(t*26,2)*sh*7;
 sc.layers.forEach((l,i)=>{if(l.visible===false)return;const o=IMG[l.imgId];if(!o||!o.im||!o.im.complete||!o.im.naturalWidth)return;
  const st=layerState(l,t),par=l.parallax??1,zf=1+(cz-1)*par,
   br=l.breath&&l.breath.amp?1+l.breath.amp*Math.sin(t*6.2832*l.breath.freq):1,
   swx=l.sway?l.sway.x*Math.sin(t*6.2832*l.sway.freq):0,swy=l.sway?l.sway.y*Math.cos(t*6.2832*l.sway.freq*.83):0,
   jx=l.jitter?vn(t*34+i*5,3+i)*l.jitter:0,jy=l.jitter?vn(t*34+i*5,9+i)*l.jitter:0;
  const w=o.im.naturalWidth,h=o.im.naturalHeight,s=(CW/w)*st.scale*zf*br,pv=l.pivot||{x:.5,y:.5},ox=(pv.x-.5)*w*s,oy=(pv.y-.5)*h*s;
  ctx.save();ctx.globalAlpha=clamp(st.opacity,0,1);ctx.globalCompositeOperation=l.blend||'source-over';
  ctx.translate(CW/2+st.x+(ccx+shx)*par+swx+jx,CH/2+st.y+(ccy+shy)*par+swy+jy);ctx.translate(ox,oy);ctx.rotate(st.rot*Math.PI/180);ctx.translate(-ox,-oy);ctx.scale(s,s);ctx.drawImage(o.im,-w/2,-h/2);ctx.restore()});
 const fx=sc.fx||{};ctx.globalCompositeOperation='source-over';
 if(fx.tintOp>0){ctx.globalAlpha=fx.tintOp;ctx.fillStyle=fx.tint||'#000';ctx.fillRect(0,0,CW,CH)}
 if(fx.grain>0){ctx.globalAlpha=clamp(fx.grain,0,1)*.55;ctx.drawImage(grain[Math.floor(t*GRAIN_HZ)%grain.length],0,0,CW,CH)}
 if(fx.vignette>0){const g=ctx.createRadialGradient(CW/2,CH/2,CH*.18,CW/2,CH/2,CH*.68);g.addColorStop(0,'rgba(0,0,0,0)');g.addColorStop(1,'rgba(0,0,0,'+clamp(fx.vignette,0,1)+')');ctx.globalAlpha=1;ctx.fillStyle=g;ctx.fillRect(0,0,CW,CH)}
 if(fx.flicker>0){const v=Math.max(0,hash(Math.floor(t*14)*1.9+3)),b=Math.max(0,hash(Math.floor(t*5)*4.1))>.82?.5:0;ctx.globalAlpha=clamp((v*v*fx.flicker*1.3)+b*fx.flicker,0,.8);ctx.fillStyle='#000';ctx.fillRect(0,0,CW,CH)}
 let fa=0;if(fx.fadeIn>0)fa=Math.max(fa,1-t/fx.fadeIn);if(fx.fadeOut>0)fa=Math.max(fa,1-(sc.duration-t)/fx.fadeOut);
 if(fa>0){ctx.globalAlpha=clamp(fa,0,1);ctx.fillStyle='#000';ctx.fillRect(0,0,CW,CH)}
 if(fx.subtitles&&sc.narration&&!opt.nosub){ctx.globalAlpha=1;ctx.font='600 19px system-ui,sans-serif';ctx.textAlign='center';const words=sc.narration.split(' '),lines=[];let ln='';for(const w of words){const tt=ln?ln+' '+w:w;if(ctx.measureText(tt).width>470){lines.push(ln);ln=w}else ln=tt}lines.push(ln);const lh=25,bh=lines.length*lh+14,y0=CH-70-bh;ctx.fillStyle='rgba(0,0,0,.55)';ctx.fillRect(24,y0,CW-48,bh);ctx.fillStyle='#f1ece2';lines.forEach((s,i)=>ctx.fillText(s,CW/2,y0+25+i*lh))}
 ctx.restore()}
function draw(){const sc=S();cx.setTransform(1,0,0,1,0,0);if(!sc){cx.fillStyle='#000';cx.fillRect(0,0,CW,CH);return}render(cx,sc,LT(),1);$('#tt').textContent=G.toFixed(2)+' / '+totalDur().toFixed(2)+'s';$('#seek').value=totalDur()?G/totalDur()*10000:0;drawTL()}
let thumbTimer;function thumbs(){clearTimeout(thumbTimer);thumbTimer=setTimeout(()=>{$$('#sceneList canvas').forEach((c,i)=>{const sc=P.scenes[i];if(!sc)return;const g=c.getContext('2d');g.setTransform(1,0,0,1,0,0);render(g,sc,Math.min(sc.duration*.25,2),c.width/CW,{nosub:true})})},120)}

/* ============ LISTAS / INSPETOR ============ */
function listScenes(){const el=$('#sceneList');el.innerHTML='';P.scenes.forEach((sc,i)=>{const d=document.createElement('div');d.className='item'+(i===cur?' sel':'');d.innerHTML='<canvas width="27" height="48"></canvas><div class="nm">'+esc(sc.name)+'<br><small>'+sc.duration+'s · '+sc.layers.length+' camadas</small></div>';d.onclick=()=>{setG(sceneStart(i));curL=sc.layers.length?sc.layers.length-1:-1;selKey=null;fixTrack();all()};el.appendChild(d)});thumbs()}
function listLayers(){const el=$('#layerList');el.innerHTML='';const sc=S();if(!sc)return;for(let i=sc.layers.length-1;i>=0;i--){const l=sc.layers[i],o=IMG[l.imgId],d=document.createElement('div');d.className='item'+(i===curL?' sel':'');d.innerHTML='<img src="'+(o?o.data:'')+'"><div class="nm">'+esc(l.name)+'<br><small>z '+i+' · prof '+(l.parallax??1)+'</small></div><input type="checkbox" '+(l.visible!==false?'checked':'')+' title="visível">';d.querySelector('input').onclick=e=>{e.stopPropagation();snap();l.visible=e.target.checked;draw()};d.onclick=()=>{curL=i;if(selTrack.kind==='layer')selTrack.li=i;all()};el.appendChild(d)}}
function num(label,get,set,step=1,keyed){const r=document.createElement('div');r.className='row';const v=document.createElement('div');v.className='v';const i=document.createElement('input');i.type='number';i.step=step;i.value=+(+get()).toFixed(3);i.onchange=()=>{snap();set(parseFloat(i.value)||0);all(true)};v.appendChild(i);if(keyed){const b=document.createElement('button');b.className='sm';b.textContent='◆';b.title='Keyframe no tempo atual';b.onclick=()=>{snap();addKeyFor(keyed);all(true)};v.appendChild(b)}r.innerHTML='<label>'+label+'</label>';r.appendChild(v);return r}
function txt(label,get,set,area){const r=document.createElement('div');r.className='row';r.style.gridTemplateColumns=area?'1fr':'96px 1fr';const i=document.createElement(area?'textarea':'input');i.value=get();i.onchange=()=>{snap();set(i.value);all(true)};r.innerHTML='<label>'+label+'</label>';r.appendChild(i);return r}
function chk(label,get,set){const r=document.createElement('div');r.className='row';const i=document.createElement('input');i.type='checkbox';i.checked=!!get();i.onchange=()=>{snap();set(i.checked);all(true)};r.innerHTML='<label>'+label+'</label>';const v=document.createElement('div');v.appendChild(i);r.appendChild(v);return r}
function col(label,get,set){const r=document.createElement('div');r.className='row';const i=document.createElement('input');i.type='color';i.value=get();i.onchange=()=>{snap();set(i.value);all(true)};r.innerHTML='<label>'+label+'</label>';const v=document.createElement('div');v.appendChild(i);r.appendChild(v);return r}
function sel(label,opts,get,set){const r=document.createElement('div');r.className='row';const s=document.createElement('select');opts.forEach(([v,n])=>{const o=document.createElement('option');o.value=v;o.textContent=n;s.appendChild(o)});s.value=get();s.onchange=()=>{snap();set(s.value);all(true)};r.innerHTML='<label>'+label+'</label>';r.appendChild(s);return r}
function addKeyFor(tr){const o=trackObj(tr);if(!o)return;setKey(o.keys,LT(),evalKeys(o.keys,LT(),o.base))}
function camNum(label,prop,step){const tr={kind:'cam',prop};return num(label,()=>evalKeys(S().camera[prop],LT(),prop==='zoom'?1:0),v=>{setKey(S().camera[prop],LT(),v)},step,tr)}
function layNum(label,prop,step){const tr={kind:'layer',li:curL,prop};const l=S().layers[curL];return num(label,()=>evalKeys(l.keys[prop],LT(),l[prop]),v=>{if(l.keys[prop].length)setKey(l.keys[prop],LT(),v);else l[prop]=v},step,tr)}
const clipObj=()=>P.clips.find(c=>c.id===selClip);
function inspector(){const el=$('#insp');el.innerHTML='';const sc=S();if(!sc){el.textContent='Sem cena.';return}const l=sc.layers[curL];
 if(tab==='scene'){el.append(txt('Nome',()=>sc.name,v=>sc.name=v),num('Duração (s)',()=>sc.duration,v=>{sc.duration=Math.max(.5,v)},.5),txt('Narração',()=>sc.narration,v=>sc.narration=v,true),txt('Som',()=>sc.sound,v=>sc.sound=v,true),txt('Notas',()=>sc.notes,v=>sc.notes=v,true),num('Tremor câmera',()=>sc.shake,v=>sc.shake=v,.1));
  const h=document.createElement('div');h.className='hint';h.textContent='Câmera (keyframes): zoom 1 = normal; x e y movem a câmera em pixels.';el.append(h,camNum('Zoom','zoom',.05),camNum('Pan X','x',5),camNum('Pan Y','y',5))}
