function setMode(m){tlMode=m;$('#mProj').classList.toggle('on',m==='proj');$('#mKey').classList.toggle('on',m==='key');$('#barProj').style.display=m==='proj'?'':'none';$('#barKey').style.display=m==='key'?'':'none';$('#hintTL').textContent=m==='proj'?'Arraste clipes/bordas · clique na régua para ir ao tempo · arraste cenas para reordenar · solte áudios aqui':'Duplo clique = novo keyframe · arraste ◆ · clique na régua para ir ao tempo';tlZoom=1;wrap.scrollLeft=0;draw()}
