  P.tracks.forEach((tk,ti)=>{const y=RULER+SCH+ti*TRH;tg.fillStyle=ti%2?'#181a1d':'#1b1d21';tg.fillRect(0,y,W,TRH);tg.strokeStyle='#23262b';tg.strokeRect(0,y+.5,W,TRH)});
  P.clips.forEach(c=>{const ti=P.tracks.findIndex(t=>t.id===c.track);if(ti<0)return;const a=AUD[c.aud];const y=RULER+SCH+ti*TRH+3,h=TRH-6,x0=t2x(c.start),w=c.dur*pps();const on=c.id===selClip;tg.fillStyle=on?'#1f5266':'#1a3b4a';tg.fillRect(x0,y,w,h);
   if(a&&a.peaks){const pr=a.pps;tg.strokeStyle=on?'#9fe0f5':'#6fb5cf';tg.beginPath();const px=Math.max(1,Math.floor(w));for(let p=0;p<px;p+=1){const tt=c.off+p/pps();const i0=Math.floor(tt*pr),i1=Math.max(i0+1,Math.floor((tt+1/pps())*pr));let m=0;for(let i=i0;i<i1&&i<a.peaks.length;i++)if(a.peaks[i]>m)m=a.peaks[i];const hh=Math.min(h/2-2,m*(h/2-2)*Math.min(c.vol,2));tg.moveTo(x0+p+.5,y+h/2-hh);tg.lineTo(x0+p+.5,y+h/2+hh)}tg.stroke()}
   tg.strokeStyle=on?'#fff':'#3b7f9a';tg.strokeRect(x0+.5,y+.5,w-1,h-1);tg.fillStyle='#fff';tg.save();tg.beginPath();tg.rect(x0,y,w,h);tg.clip();tg.fillText(c.name,x0+4,y+8);tg.restore();
   tg.fillStyle='#ffffff55';if(c.fi>0)tg.fillRect(x0,y+h-3,c.fi*pps(),3);if(c.fo>0)tg.fillRect(x0+w-c.fo*pps(),y+h-3,c.fo*pps(),3)});
  // rótulos fixos (acompanham o scroll horizontal)
